# Copy to .env and edit for your environment.
# Defaults below match docker-compose.yml so `cp .env.example .env` works out of the box.

# ---------------------------------------------------------------------------
# Backing services
# ---------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=tasks.events
KAFKA_CONSUMER_GROUP=task-dependency-service

# ---------------------------------------------------------------------------
# Security  (REQUIRED for any externally accessible deployment)
# ---------------------------------------------------------------------------
# API key — when set, all task endpoints require `X-API-Key: <value>`.
# Generate a strong value with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=

# ---------------------------------------------------------------------------
# TLS for backing services  (recommended for production)
# ---------------------------------------------------------------------------
# MongoDB with TLS (append ?tls=true; add &tlsCAFile=... for custom CA):
# MONGODB_URL=mongodb://user:password@host:27017/taskdb?authSource=admin&tls=true
#
# Redis with TLS (rediss:// scheme enables TLS automatically):
# REDIS_URL=rediss://:password@host:6379
#
# Kafka TLS: set security_protocol in the consumer; not yet configurable via env —
# see app/services/kafka_consumer.py AIOKafkaConsumer for the ssl_context parameter.

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Default (memory://) is per-process. For multi-replica deployments use Redis
# so all instances share counters:
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Use json in production for structured log ingestion (ELK, CloudWatch, Datadog):
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Tuneables
# ---------------------------------------------------------------------------
# MAX_CHAIN_DEPTH=100
# CACHE_CHAIN_TTL_SECONDS=3600
# CACHE_INCOMPLETE_CHAIN_TTL_SECONDS=30
# SHUTDOWN_TIMEOUT_SECONDS=30